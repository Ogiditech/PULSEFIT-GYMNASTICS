{
  "name": "pulsefit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-env.js",
    "dev": "concurrently -k -n db,api,web -c magenta,cyan,green \"node --env-file-if-exists=.env scripts/local-db.js\" \"node --env-file-if-exists=.env server/watch.js\" \"vite\"",
